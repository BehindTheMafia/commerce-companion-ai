SUPABASE_PROJECT_ID="your-supabase-project-ref"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-supabase-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your-imagekit-id"
VITE_IMAGEKIT_PUBLIC_KEY="your-imagekit-public-key"
IMAGEKIT_PRIVATE_KEY="your-imagekit-private-key"
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"

# --- Push notifications (required for new-order pushes) ---
# Generate keys: node scripts/generate-vapid.mjs
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@yourdomain.com"
VITE_VAPID_PUBLIC_KEY="your-vapid-public-key"
# Server-only key used by /api/push/* routes (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
